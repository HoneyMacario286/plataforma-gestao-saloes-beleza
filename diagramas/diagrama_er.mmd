    SALAO {
        int id_salao PK
        string nome
        string cidade
        string telefone
    }
    UTILIZADOR {
        int id_utilizador PK
        int id_salao FK
        string email
        string perfil
    }
    CLIENTE {
        int id_cliente PK
        string nome_completo
        string telefone
    }
    FUNCIONARIO {
        int id_funcionario PK
        int id_salao FK
        string nome_completo
        string especialidade
    }
    PROCEDIMENTO {
        int id_procedimento PK
        int id_salao FK
        string nome
        decimal preco
        int duracao_minutos
    }
    MARCACAO {
        int id_marcacao PK
        int id_salao FK
        int id_cliente FK
        int id_procedimento FK
        int id_funcionario FK
        datetime data_hora
        string estado
    }
    HISTORICOMARCACAO {
        int id_historico PK
        int id_marcacao FK
        string estado_anterior
        string estado_novo
    }
    PRODUTO {
        int id_produto PK
        int id_salao FK
        string nome
        int quantidade
    }
    MOVIMENTOSTOCK {
        int id_movimento PK
        int id_produto FK
        string tipo
        int quantidade
    }
    HORARIOFUNCIONARIO {
        int id_horario PK
        int id_funcionario FK
        string dia_semana
        string tipo_dia
    }
    ATENDIMENTO {
        int id_atendimento PK
        int id_salao FK
        int id_cliente FK
        int id_funcionario FK
        int id_procedimento FK
        int id_marcacao FK
        decimal valor_pago
    }

